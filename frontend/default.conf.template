server {
  listen 80;
  server_name _;

  # Límite de tamaño de cuerpo para uploads grandes (imágenes SAR ZIP ~4GB)
  client_max_body_size 10g;
  # Tiempo máximo para recibir el body de una request (upload lento)
  client_body_timeout 600s;
  client_header_timeout 600s;

  resolver 127.0.0.11 valid=30s ipv6=off;
  set $backend_upstream ${BACKEND_UPSTREAM};

  root /usr/share/nginx/html;
  index index.html;

  location /api/ {
    proxy_pass         http://$backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    client_max_body_size 500m;
  }

  location /resultados_comparativa/ {
    proxy_pass         http://$backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
  }

  location /mintpy_results/ {
    proxy_pass         http://$backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Host $host;
    proxy_set_header   X-Real-IP $remote_addr;
    proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
  }

  location ^~ /geo-desk/api/ {
    rewrite ^/geo-desk/(.*)$ /$1 break;
    proxy_pass         http://$backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    client_max_body_size 500m;
  }

  location /geo-desk/ {
    alias /usr/share/nginx/html/;
    try_files $uri $uri/ /index.html;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}