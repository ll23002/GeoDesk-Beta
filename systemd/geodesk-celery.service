[Unit]
Description=GeoDesk-Beta — Plataforma de Monitoreo Geodésico InSAR (Docker Compose)
# Solo arranca una vez que Docker está completamente operativo
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
# Tipo de servicio
# "oneshot" con RemainAfterExit le indica a Systemd que el proceso de arranque
# termina (docker compose up -d corre y sale), pero el servicio se considera
# activo mientras los contenedores estén corriendo.
Type=oneshot
RemainAfterExit=yes

# Usuario de ejecución
# El usuario debe pertenecer al grupo "docker" para poder ejecutar comandos Docker
# sin sudo. Ejecutar: sudo usermod -aG docker <usuario>
User=geociencias
Group=geociencias

# Directorio del proyecto
# Debo arreglar esto
WorkingDirectory=/home/geociencias/GeoDesk-Beta

# Comandos de inicio y parada
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down

# Política de reinicio
Restart=on-failure
RestartSec=10s

TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
